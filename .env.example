# Supabase — dedicated Upside Lab project (without these → local demo)
# Client (browser) must use the NEXT_PUBLIC_ names. Server also accepts
# SUPABASE_URL / SUPABASE_ANON_KEY as aliases for the same values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Google OAuth (own-domain callback so sign-in says upsidelab.app, not supabase.co)
# Client from Google Cloud → Auth Platform → Clients → Upside Lab
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# Prefer service role for API writes + seed claims (bypasses RLS intentionally)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Signs the one-click unsubscribe link at the foot of the Sunday letter.
# Optional: with it unset the service role key signs them instead, which
# works. Set it if you would rather the two were not the same string. With
# neither, the letter carries no unsubscribe link at all, because a link
# anybody could forge would let a stranger stop a stranger's letter.
# UNSUBSCRIBE_SECRET=a-long-random-string
# Direct Postgres (session / port 5432) is for dumps and psql only. Do not
# open this from a Vercel function: each client holds a backend until it
# disconnects, and the dedicated project caps out at 60.
# DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres
#
# Transaction-mode pooler (port 6543) if you ever open a Postgres client from
# a function. The app itself talks HTTPS to PostgREST, which already uses
# this pooler. Session mode is the wrong choice for serverless.
# DATABASE_POOLER_URL=postgresql://postgres.your-ref:[password]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Optional seed emails for Karud / Lap Google accounts (Martin is in DB seed_claims)
# UPSIDE_SEED_KARUD_EMAIL=karud@example.com
# UPSIDE_SEED_LAP_EMAIL=lap@example.com

# Vercel Cron auth for /api/cron/snapshot (set the same value in Vercel → Cron)
CRON_SECRET=change-me-to-a-long-random-string

# Dead-man's-switch for the crons (docs/CRON_MONITORING.md). Every scheduled
# route pings <base>/<its-own-name> after a successful run and /fail after a
# failed one, so a cron that silently stops firing raises an alert instead
# of waiting for a person to notice. Ping base from Healthchecks.io (or any
# service with the same URL shape). Optional; unset, no pings are sent.
# CRON_HEARTBEAT_BASE=https://hc-ping.com/your-ping-key

# Disaster recovery (encrypted book JSON to R2/S3 + WAL backup check).
# See docs/DISASTER_RECOVERY.md. All optional; the 03:00 UTC cron still
# captures the book and records warnings when these are unset.
# SNAPSHOT_ENCRYPTION_KEY=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=uzrnybyggznpvgxgrvgl
# DR_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# DR_S3_REGION=auto
# DR_S3_BUCKET=upside-lab-backups
# DR_S3_ACCESS_KEY_ID=
# DR_S3_SECRET_ACCESS_KEY=
# DR_S3_PREFIX=upside-lab/book-snapshots
# DR_BACKUP_MAX_AGE_HOURS=36
# DR_COLD_RETENTION_DAYS=30

# The Sunday letter. Key from https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM=Upside Lab <notes@upsidelab.app>

# Upside Fund posts on X after the weekday 21:30 UTC fund cron.
# Create @UpsideFund, then a developer app at https://developer.x.com
# with Read and Write user tokens (OAuth 1.0a). All four required.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# Auto-posting is opt-in, and having the keys above is NOT the opt-in.
# Credentials stay valid across a paused/depleted X plan, so "keys are
# set" used to mean "post on every fund run" long after the account had
# run out of credits -- each run then burned a request to be told 402 and
# wrote a red row into /admin. Set this to true only once there are
# credits to spend. Unset, nothing ever calls X.
# The fund still composes and stores each day's post either way, so it
# can be posted by hand from the Fund page.
# X_POSTING_ENABLED=true

# Canonical host is the apex only. www.upsidelab.app 301s there.
# Set these in Vercel only AFTER upsidelab.app is attached as a production
# domain. Until then, leave them unset so the live alias is not 301'd onto
# a parking page. UPSIDE_CANONICAL_HOST wins if both are set.
# UPSIDE_CANONICAL_HOST=upsidelab.app
# NEXT_PUBLIC_SITE_URL=https://upsidelab.app

# Market data — Yahoo (yahoo-finance2, no key) is primary and free. These are
# OPTIONAL extra free-tier fallbacks used only for tickers Yahoo couldn't
# price; the app works fine with none of them set.
# Twelve Data: 800 credits/day free, no card — https://twelvedata.com/pricing
# TWELVE_DATA_API_KEY=your_key_here
# Finnhub: 60 calls/min free, no card — https://finnhub.io/register
# FINNHUB_API_KEY=your_key_here

# Assistant Margus — OpenRouter (OpenAI-compatible)
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here
MODEL=nvidia/nemotron-3-super-120b-a12b:free
MODEL_VISION=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Comma-separated OpenRouter fallbacks when primary is rate-limited
# MODEL_FALLBACKS=nvidia/nemotron-3-nano-30b-a3b:free,openai/gpt-oss-20b:free
# Max IQ (slow): MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Fast/light: MODEL=nvidia/nemotron-3-nano-30b-a3b:free
# MODEL=openai/gpt-oss-20b:free

# Optional forecast-only model override (falls back to MODEL)
# MODEL_FORECAST=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL=...
# OPENROUTER_VISION_MODEL=...
# OPENROUTER_HTTP_REFERER=https://upsidelab.app
# OPENROUTER_APP_TITLE=Upside Lab Assistant Margus

# Optional Groq fallback (also OpenAI-compatible, free tier, no card).
# openai/gpt-oss-120b specifically -- Groq's structured-output guarantee
# (needed by forecast/thesis-pulse/margus-fund) is limited to the gpt-oss
# family; other Groq models 400 on any generateObject call.
# Get a key: https://console.groq.com/keys
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Optional Gemini fallback (free tier, no card, natively multimodal so it
# also covers vision/screenshot-import requests). Use the rolling "-latest"
# alias, not a dated snapshot -- Google retires dated model IDs over time.
# Get a key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-flash-latest

# Cerebras was evaluated and deliberately skipped: despite "start building
# for free" marketing, every model requires a verified payment method
# before any inference call works at all (a $5, 30-day trial credit is
# granted only after a card is added) -- not the no-card free tier the
# other providers above genuinely are. Not worth it as a 4th fallback tier
# behind three providers that already work without a card.

# Margus tries every configured provider above in order (OpenRouter -> Groq
# -> Gemini) before giving up, so one provider running out of free-tier
# quota doesn't take the assistant down if you've set up more than one.
# None of these are required — the app works with just OPENROUTER_API_KEY,
# same as before.

# Stripe Billing + Tax. Product/Price created in the Stripe Dashboard;
# webhook secret comes from `stripe listen` (dev) or the Dashboard
# webhook endpoint (prod).
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
# STRIPE_PRICE_ID=price_xxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
