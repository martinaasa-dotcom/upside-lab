{
  "name": "upside-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-pwa-icons.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:ci-env": "npx tsx scripts/check-ci-env.ts",
    "prepare": "husky",
    "validate": "npx tsx scripts/validate-audit-features.ts",
    "check:edges": "npx tsx scripts/edge-audit.mts",
    "test:invariants": "npx tsx scripts/test-invariants.ts",
    "bench:concurrency": "npx tsx scripts/bench-concurrency.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:landing": "node scripts/landing-smoke.mjs",
    "probe:models": "npx tsx scripts/probe-free-models.ts",
    "dr:export": "npx tsx scripts/export-cold-snapshot.ts",
    "dr:restore": "npx tsx scripts/restore-snapshot.ts",
    "migrate:online": "npx tsx scripts/migrate-online.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "cron:checks": "npx tsx scripts/setup-healthchecks.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.36",
    "@ai-sdk/react": "^4.0.61",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.58",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.20.0",
    "sonner": "^2.0.8",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "yahoo-finance2": "^4.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "playwright": "^1.62.1",
    "shadcn": "^4.18.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,mjs}": "eslint --max-warnings 0 --no-warn-ignored"
  }
}
