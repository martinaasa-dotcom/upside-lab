# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI
supabase/.temp/

# local disaster-recovery dry runs
.dr-local/

# personal Claude Code overrides (not for the team)
.claude/settings.local.json
.claude/worktrees/
test-results/

# Throwaway Playwright scripts written by audit agents while they measure the app
scripts/_tmp_*

# A locked demo save is one person's real holdings. It stays on the machine
# that made it: the dev route that writes it refuses to answer on any
# deployment, and this repository is public.
data/locked-demo.json
